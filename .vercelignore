# Files never deployed to Vercel. Public files that stay: js/, css/,
# data/*.json (offline fallback), index.html, vercel.json, package.json.

# Secrets / environment templates — must never be uploaded
.env
.env.example

# Repo/dev config
.gitignore

# Documentation
*.md
docs/

# CI/test scripts — sync.js MUST stay: npm run build runs node scripts/sync.js
scripts/*
!scripts/sync.js

# Transient artifact of sync.js atomic writes (temp + rename)
data/*.tmp